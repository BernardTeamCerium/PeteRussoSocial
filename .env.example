# ─── Core ───────────────────────────────────────────────────────────
PORT=3000
# Password for the admin dashboard (basic auth, user "admin"). Leave blank only for local use.
ADMIN_PASSWORD=
# Public base URL, used when building share links
BASE_URL=http://localhost:3000
# How often to collect fresh data, in minutes (0 = only manual / cron via `npm run collect`)
COLLECT_INTERVAL_MINUTES=360
# When true and a source has no credentials, demo data is generated so the dashboard is never empty
DEMO_MODE=true

# ─── Brand / disambiguation ─────────────────────────────────────────
BRAND_NAME=Pete Russo
BRAND_DOMAIN=peterusso.com
# Shown in the dashboard banner (from the PeteRusso.com title)
BRAND_TAGLINE=Executive Leadership Coaching
# Search phrases to monitor (comma separated)
BRAND_QUERIES="Pete Russo","Peter Russo",peterusso.com
# Words that make a mention MORE likely to be about our Pete Russo (comma separated)
BRAND_CONTEXT_KEYWORDS=executive leadership,leadership coach,executive coach,coaching,keynote,speaker,entrepreneur,founder,team building,boardroom,linkedin.com/in/pete-russo
# Words that indicate a DIFFERENT Pete/Peter Russo, e.g. the House of Cards character (comma separated)
BRAND_EXCLUDE_KEYWORDS=House of Cards,Kevin Spacey,Corey Stoll,Australian rules,AFL,Mad Dog
# Keywords to track rankings for (comma separated)
SEO_KEYWORDS=pete russo,peter russo,pete russo website

# ─── Mentions sources ───────────────────────────────────────────────
# Google News RSS, Reddit, Hacker News and GDELT need no key.
# SerpAPI (Google web results + rank tracking): https://serpapi.com
SERPAPI_KEY=
# YouTube Data API v3 key (mentions in videos + channel stats)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── Social accounts ────────────────────────────────────────────────
# Meta Graph API long-lived token with instagram_basic / pages_read_engagement
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=
# X (Twitter) API v2 bearer token + username (without @)
X_BEARER_TOKEN=
X_USERNAME=

# ─── Google (Search Console + GA4) ──────────────────────────────────
# Path to a Google Cloud service-account JSON key. Add the service account's email
# as a user in Search Console (property below) and in GA4 (Viewer role).
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# e.g. sc-domain:peterusso.com  or  https://peterusso.com/
GSC_SITE_URL=sc-domain:peterusso.com
# GA4 numeric property id (Admin → Property settings)
GA4_PROPERTY_ID=
# PageSpeed Insights API key (optional; works without one at low volume)
PAGESPEED_API_KEY=

# ─── Sharing / notifications ───────────────────────────────────────
# Optional Slack incoming-webhook URL; the weekly summary is posted here
SLACK_WEBHOOK_URL=
